NODE_ENV=development
API_PORT=4000
CLIENT_URL=http://localhost:5173
API_URL=http://localhost:4000
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-a-long-secret
JWT_ACCESS_EXPIRY=15m

# ---- Firebase Configuration ----
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-project-id","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxx@your-project-id.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-xxx%40your-project-id.iam.gserviceaccount.com"}

# ---- For Firebase Cloud Functions Deployment ----
# Set these when deploying to Cloud Functions
# FUNCTIONS_EMULATOR=false
